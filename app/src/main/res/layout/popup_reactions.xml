<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/reaction_background"
    android:elevation="8dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/reaction1"
        style="@style/ReactionEmoji"
        android:text="❤️"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/reaction2"
        style="@style/ReactionEmoji"
        android:text="👍"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/reaction3"
        style="@style/ReactionEmoji"
        android:text="😂"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/reaction4"
        style="@style/ReactionEmoji"
        android:text="😮"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/reaction5"
        style="@style/ReactionEmoji"
        android:text="😢"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/reaction6"
        style="@style/ReactionEmoji"
        android:text="😡"
        tools:ignore="HardcodedText" />

</LinearLayout>
